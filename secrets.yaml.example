# Example secrets file — copy to secrets.yaml and fill in real values.
# secrets.yaml is gitignored and must never be committed.
# Learn more at https://www.home-assistant.io/docs/configuration/secrets/

# Oura Ring API token (https://cloud.ouraring.com/personal-access-tokens)
oura_token: "Bearer YOUR_OURA_TOKEN_HERE"

# Healthchecks.io dead-man's-switch ping URL for the Core heartbeat
# automation (packages/core_heartbeat.yaml). Create a check with
# Period 10m + Grace 5m and paste its ping URL here.
healthchecks_core_heartbeat_url: "https://hc-ping.com/YOUR-CHECK-UUID"

# Full API URLs that embed your home coordinates. Kept here (not in the
# packages) so the location never lands in the public repo. Replace the
# 0.0 values with your own latitude / longitude.
open_meteo_air_quality_url: "https://air-quality-api.open-meteo.com/v1/air-quality?latitude=0.0&longitude=0.0&current=us_aqi,pm2_5,pm10,ozone,nitrogen_dioxide,sulphur_dioxide,carbon_monoxide,dust,uv_index&hourly=us_aqi&forecast_days=4&timezone=America%2FNew_York"
open_meteo_forecast_url: "https://api.open-meteo.com/v1/forecast?latitude=0.0&longitude=0.0&current=shortwave_radiation,direct_radiation,diffuse_radiation,cloud_cover&timezone=America%2FNew_York"
google_pollen_url: "https://pollen.googleapis.com/v1/forecast:lookup?location.longitude=0.0&location.latitude=0.0&days=1"
