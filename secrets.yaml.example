# Example secrets file — copy to secrets.yaml and fill in real values.
# secrets.yaml is gitignored and must never be committed.
# Learn more at https://www.home-assistant.io/docs/configuration/secrets/

# Oura Ring API token (https://cloud.ouraring.com/personal-access-tokens)
oura_token: "Bearer YOUR_OURA_TOKEN_HERE"

# Healthchecks.io dead-man's-switch ping URL for the Core heartbeat
# automation (packages/core_heartbeat.yaml). Create a check with
# Period 10m + Grace 5m and paste its ping URL here.
healthchecks_core_heartbeat_url: "https://hc-ping.com/YOUR-CHECK-UUID"
